# TripWise Backend Environment Configuration Example
# Copy to .env and populate with your credentials. Never commit real keys.

# Environment and Application
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL via Supabase or local SQLite fallback)
# Production PostgreSQL example: postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./tripwise.db

# Supabase Auth and Service Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Places & Geocoding
OPENTRIPMAP_KEY=your-opentripmap-api-key
GEOAPIFY_KEY=your-geoapify-api-key

# Flights & Stays
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
DUFFEL_TOKEN=duffel_test_your_token_here

# Holidays, Events & Traffic
CALENDARIFIC_KEY=your-calendarific-key
TICKETMASTER_KEY=your-ticketmaster-key
TOMTOM_KEY=your-tomtom-key

# Imagery & Currency
UNSPLASH_KEY=your-unsplash-access-key
EXCHANGERATE_API_KEY=your-exchangerate-key

# Payments (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

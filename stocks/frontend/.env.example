# TripWise Frontend Environment Configuration Example
# IMPORTANT: Only public and client-safe keys are allowed in this file.
# Secret API keys (database passwords, private tokens) must NEVER be placed in the frontend.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Public Client Credentials (safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Razorpay Test Mode Key (Public identifier, safe for browser checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
